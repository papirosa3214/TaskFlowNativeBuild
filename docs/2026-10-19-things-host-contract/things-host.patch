+
+/** Parse the MCP tools/call response and preserve both protocol and tool errors. */
+export function parseMcpCallResponse(stdout: string): string {
+  const lines = stdout.split("\n").filter(Boolean);
+  for (let index = lines.length - 1; index >= 0; index -= 1) {
+    let message: unknown;
+    try {
+      message = JSON.parse(lines[index]!);
+    } catch {
+      continue;
+    }
+    if (!isRecord(message) || message.id !== 2) continue;
+    if (isRecord(message.error)) {
+      const error = typeof message.error.message === "string" ? message.error.message : JSON.stringify(message.error);
+      throw new Error(`Things3 вернул ошибку MCP: ${error}`);
+    }
+    if (!isRecord(message.result)) throw new Error("Things3 вернул некорректный ответ MCP");
+    const text = responseText(message.result.content);
+    if (message.result.isError === true) throw new Error(`Things3 вернул ошибку инструмента: ${text || "неизвестная ошибка"}`);
+    return text;
+  }
+  throw new Error("Things3 не ответил на вызов");
+}
